# артефакты сканера плохих PEB
# невоспроизводимые / тяжёлые артефакты
# приватный ключ подписи наших пакетов (публичный .rsa.pub публикуется)
bad-pebs*.txt
build/apk-cache/
build/bad-pebs*.txt
build/initramfs.cpio
build/initramfs-scan/
build/rootfs-custom.ubi
build/rootfs.ubifs
build/scan-initramfs.cpio.gz
build/signing/*.rsa
chroot/
gen_init_cpio
Image-ramrootfs
initramfs-scan/
*.log
# per-плата списки плохих PEB — частная история, живут рядом с flasher.sh
# RAM-ядро со вшитым сканером (собирается make-ramrootfs-kernel.sh)
rootfs/
rootfs-apk/
rootfs-min/
signing/*.rsa
# ssh host-ключи: sshd генерирует новые при первом старте, .pub публикуем
template/etc/ssh/ssh_host_ecdsa_key
template/etc/ssh/ssh_host_ed25519_key
template/etc/ssh/ssh_host_rsa_key
*.ubi
