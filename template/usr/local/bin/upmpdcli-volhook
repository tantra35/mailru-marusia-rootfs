#!/bin/sh
# upmpdcli externalvolumecontrol → volume-API marusia-d (127.0.0.1:6056).
# Dumb-труба: ExecCmd upmpdcli исполняет команду без shell (execmd.cpp:417,
# execve), поэтому пайпы в upmpdcli.conf невозможны. Вся логика громкости —
# в marusia-d: GET → визуальные 0..100, SET <0..100> → sink = v*1.5.
if [ $# -eq 0 ]; then
    printf 'GET\n'
else
    printf 'SET %s\n' "$1"
fi | nc -w 1 127.0.0.1 6056
