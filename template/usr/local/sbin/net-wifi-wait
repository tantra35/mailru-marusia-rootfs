#!/bin/sh
# Нет сохранённых сетей (свежая прошивка) - ждать нечего
ls /var/lib/iwd/*.psk >/dev/null 2>&1 || exit 0
# DHCPv4 как у автора (wifi-connect-iwd:278): ассоциацию делает iwd,
# адрес - udhcpc (EnableNetworkConfiguration в main.conf выключен).
# -b: уйти в фон и долбить ретраи, пока iwd не свяжется с сетью.
udhcpc -b -R -p /var/run/udhcpc.wlan0.pid -i wlan0 >/dev/null 2>&1
n=0
while [ $n -lt 120 ]; do
    ip -4 addr show dev wlan0 2>/dev/null | grep -q inet && exit 0
    sleep 1
    n=$((n + 1))
done
exit 0
