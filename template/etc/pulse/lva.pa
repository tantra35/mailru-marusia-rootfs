# Звук: DSP-обработка (BF/AEC/AGC) живёт В ALSA (asound.conf pcm.single_plugin),
# PA только маршрутизирует.
# Референс AEC — аппаратный loopback hw:0,2 (тап кодека), вычитается ВСЁ,
# что играет железо, независимо от PA-структуры sink'ов.
# Роли (громкость регулируемая):
#   master — default sink: музыка (mpd/DLNA), кнопки, LVA, bluetooth
#   tts    — TTS LVA (paplay -D tts на его стороне)
#   alarm  — будильники/таймеры (paplay -D alarm)
# use_volume_sharing=false ОБЯЗАТЕЛЕН: дефолт true делит громкость с мастером.
# device-restore СТРОГО ПЕРВЫМ: восстанавливает громкости при СОЗДАНИИ sink'а.
load-module module-device-restore
load-module module-alsa-sink device=hw:0,0
# Готовый тракт ассистента из ALSA (kf+BF+AEC+spp, 16k mono, AGC в DSP).
# Без micboost: AGC в DSP сам тянет уровень к таргету.
load-module module-alsa-source mmap=no device=single_plugin format=s16 channels=1 rate=16000 source_name=speex
# Сырые мики 4ch — для диагностики/сравнения.
load-module module-alsa-source device=mics format=s16 channels=4 rate=16000 channel_map=aux0,aux1,aux2,aux3 source_name=mics

# AEC теперь В DSP — sink-каскад как в webrtc-схеме не нужен: роли цепляются
# напрямую к физическому sink. Всё, что играет кодек, вычитается аппаратным
# тапом hw:0,2 независимо от того, в какой PA-sink оно сыграло.
load-module module-virtual-sink sink_name=master master=alsa_output.hw_0_0 use_volume_sharing=false
load-module module-virtual-sink sink_name=tts master=alsa_output.hw_0_0 use_volume_sharing=false
load-module module-virtual-sink sink_name=alarm master=alsa_output.hw_0_0 use_volume_sharing=false

set-default-source speex
set-default-sink master

# Локальные клиенты — unix-сокет; TCP только для LVA.
load-module module-native-protocol-unix
load-module module-native-protocol-tcp auth-ip-acl="192.168.88.0/24" auth-anonymous=1

load-module module-always-sink

# Bluetooth: телефон ведёт сам PA — поток bluez_source.<MAC>.a2dp_source, policy
# заворачивает его в default-sink; качелька телефона масштабирует звук до кодирования.
load-module module-bluetooth-policy
load-module module-bluez5-discover
