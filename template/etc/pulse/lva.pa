# Роли громкости — как в стоке: виртуальные sink'и поверх физического, физический
# держится на 100%. master (default sink) = музыка/кнопки/LVA/DLNA; tts = LVA по сети
# (paplay -D tts на его стороне); alarm = будильники/таймеры (paplay -D alarm).
# Роли — СОСЕДИ master'а (каждый форвардится в физический напрямую): громкость роли
# НЕ масштабируется громкостью master'а.
# use_volume_sharing=false ОБЯЗАТЕЛЕН: дефолт true делит громкость с master-синком
# (mvs.c:485) — роль перестанет регулироваться независимо.
# device-restore СТРОГО ПЕРВЫМ: восстанавливает громкости при СОЗДАНИИ sink'а.
load-module module-device-restore
load-module module-alsa-sink device=hw:0,0
load-module module-alsa-source device=micboost

load-module module-virtual-sink sink_name=master master=alsa_output.hw_0_0 use_volume_sharing=false
load-module module-virtual-sink sink_name=tts master=alsa_output.hw_0_0 use_volume_sharing=false
load-module module-virtual-sink sink_name=alarm master=alsa_output.hw_0_0 use_volume_sharing=false

set-default-source alsa_input.micboost
set-default-sink master

# Локальные клиенты — unix-сокет; TCP только для LVA.
load-module module-native-protocol-unix
load-module module-native-protocol-tcp auth-ip-acl="192.168.88.0/24" auth-anonymous=1

load-module module-always-sink

# Bluetooth: телефон ведёт сам PA — поток bluez_source.<MAC>.a2dp_source, policy
# заворачивает его в default-sink; качелька телефона масштабирует звук до кодирования.
load-module module-bluetooth-policy
load-module module-bluez5-discover

# AEC/NS (webrtc) ОТКЛЮЧЁН: давит полезный сигнал. Для возврата раскомментировать
# строку ниже и вернуть оба set-default на echo_cancel_*.
#load-module module-echo-cancel aec_method=webrtc use_master_format=1 use_volume_sharing=false source_master=alsa_input.micboost sink_master=alsa_output.hw_0_0 source_name=echo_cancel_source sink_name=echo_cancel_sink
