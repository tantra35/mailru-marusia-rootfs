#!/sbin/openrc-run
description="marusia-d: кольцо/сенсоры/панель-часы от состояния MPD"

command="/usr/local/bin/marusia-d"
# -lva — ЛОКАЛЬНЫЙ адрес, на котором демон-СЕРВЕР ждёт LVA (роли перевёрнуты:
# LVA — ws-клиент). Дефолт :6055, пусто = выключить peripheral API.
command_args="-mpd 127.0.0.1:6600"
command_background="yes"
pidfile="/run/marusia-d.pid"
start_stop_daemon_args="--make-pidfile"
output_logger="logger -t marusia-d"
error_logger="logger -t marusia-d"

depend() {
	need localmount
	after mpd pulseaudio
}
