#!/sbin/openrc-run
description="marusia-d: кольцо (прямой SPI)/сенсоры/панель-часы"

command="/usr/local/bin/marusia-d"
# -lva — ЛОКАЛЬНЫЙ адрес, на котором демон-СЕРВЕР ждёт LVA (роли перевёрнуты:
# LVA — ws-клиент). Дефолт :6055, пусто = выключить peripheral API.
# Кольцо: собственный SPI-транспорт (rebind+кадр через /dev/spidev0.0),
# ringled не используется.
command_args="-mpd 127.0.0.1:6600"
command_background="yes"
pidfile="/run/marusia-d.pid"
start_stop_daemon_args="--make-pidfile"
# Логгеры отключены: stdout/stderr демона уходят в /dev/null (supervise-daemon
# перекидывает fd 0/1/2 на /dev/null при детаче; без logger'ов логи не пишутся).

depend() {
	need localmount
	after mpd pulseaudio
}
