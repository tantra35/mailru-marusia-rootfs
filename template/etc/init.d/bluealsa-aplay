#!/sbin/openrc-run
# Без supervisor=supervise-daemon — единообразно с mpd/upmpdcli/marusia-d:
# демон без автоперезапуска (упал = лежит до ручного рестарта). aplay
# держится в foreground под command_background: start-stop-daemon форкает,
# пишет pid и уходит, демон переподвешивается на init (ppid=1).
description="Bluetooth audio to the speaker"
command="/usr/bin/bluealsa-aplay"
command_args="--pcm=default"
command_background="yes"
pidfile="/run/bluealsa-aplay.pid"
start_stop_daemon_args="--make-pidfile"

depend() {
	need bluealsa
	after alsa
}
