# Maintainer: Clayton Craft <clayton@craftyguy.net>
# VK Mini fork: pkgrel=102 (v3 порогов: enr 3.0/trigger 4/hold 250 + nearend_tuning 3.0/4.0 + normal dec 0.5) — наш репозиторий перекрывает апстрим 1.3-r3.
# Патч aec3-nearend-thresholds.patch: ослабляет пороги nearend-детектора AEC3
# (suppression_gain.cc:196 — в nearend-состоянии suppressor почти прозрачен).
# Диагноз 2026-11-17: при громком воспроизведении остаточное эхо выше речи,
# детектор с enr_threshold=.25 (нужно ne ≥ 4× остатка) никогда не срабатывал,
# suppressor давил ВСЁ (речь в выходе AEC ~-50 дБFS). enr_threshold=1.0 →
# триггер при ne ≥ остатка; trigger 8 кадров быстрее, hold 75 (~1.2 с) держит
# открытым между словами. Обоснование и замеры: skill marusia,
# references/mic-array.md, раздел «Диагностика AEC3».
pkgname=webrtc-audio-processing-1
pkgver=1.3
pkgrel=102
pkgdesc="AudioProcessing module from the WebRTC project (VK Mini: AEC3 nearend thresholds relaxed)"
url="https://www.freedesktop.org/software/pulseaudio/webrtc-audio-processing/"
# does not support big endian
arch="all !s390x"
license="custom"
makedepends="
	abseil-cpp-dev
	meson
	cmake
	libtool
	linux-headers
	"
subpackages="$pkgname-dev"
source="
	https://gitlab.freedesktop.org/pulseaudio/webrtc-audio-processing/-/archive/v$pkgver/webrtc-audio-processing-v$pkgver.tar.gz
	0001-rtc_base-Include-stdint.h-to-fix-build-failures.patch
	byte-order-detection.patch
	gcc-15.patch
	aec3-nearend-thresholds.patch
	"
options="!check" # No tests
builddir="$srcdir/webrtc-audio-processing-v$pkgver"

build() {
	abuild-meson \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir" meson install -C output
}

