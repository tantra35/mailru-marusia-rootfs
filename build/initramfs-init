#!/bin/sh
# /init аварийного сканера плохих PEB (initramfs целиком в RAM).
# NAND не монтируется и не пишется: скан — только чтение /dev/mtd*.
# console= задаёт flasher.sh (rdinit=/init).
#
# Вывод: UART (console=) И USB ACM-gadget — на хосте /dev/ttyACM0.
#
# ПОЧЕМУ ПИНАЕТСЯ bind: dwc2 (ff400000.usb) может уйти в deferred probe
# (phy ещё не готов) и дальше просыпаться только по новым событиям —
# которых в голом initramfs не бывает. Запись в drivers/dwc2/bind
# каждый секунду заставляет ядро повторять probe, пока не появится UDC.
# Появившийся UDC мгновенно занимает авто-гаджет g_serial (USB_G_SERIAL=y,
# он же console=ttyGS0) — отвязываем его и вешаем свой ACM-gadget.

PATH=/bin
umask 022

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev || mdev -s
# /config — точка монтирования configfs, СОЗДАНА В САМОМ initramfs:
# /sys/kernel/config в sysfs не существует и mkdir там не пройдёт
mount -t configfs none /config 2>/dev/null

# маячок глазами: фазы на панель-часах (seg-led, без USB)
panel() {
	for d in /sys/bus/platform/devices/*/linedisp.* /sys/class/linedisp/*; do
		[ -e "$d/message" ] && { echo "$1" > "$d/message" 2>/dev/null; return 0; }
	done
	return 1
}
panel "1111"   # /init стартовал, devtmpfs жив
panel "2222"   # ждём UDC (dwc2 пинается bind'ом)

udc=''
n=0
while [ "$n" -lt 120 ]; do
	echo ff400000.usb > /sys/bus/platform/drivers/dwc2/bind 2>/dev/null
	udc=$(ls /sys/class/udc 2>/dev/null | head -n 1)
	[ -n "$udc" ] && break
	sleep 1
	n=$((n + 1))
done

G=/config/usb_gadget/scan
gadget=''
mkdir -p "$G/functions/acm.usb0" "$G/configs/c.1" 2>/dev/null
echo 0x1d6b > "$G/idVendor"    # Linux Foundation
echo 0x0104 > "$G/idProduct"
mkdir -p "$G/strings/0x409"
echo "marusia-scan" > "$G/strings/0x409/product"
ln -s "$G/functions/acm.usb0" "$G/configs/c.1/acm.usb0"

# g_serial занял только что появившийся UDC — отвязать и занять своим
for u in /sys/class/udc/*; do
	[ -e "$u/UDC" ] && echo "" > "$u/UDC" 2>/dev/null
done

if [ -n "$udc" ] && echo "$udc" > "$G/UDC" 2>/dev/null; then
	gadget=yes
	panel "3333"   # UDC привязан, гаджет сконфигурирован
	sleep 1   # дать хосту увидеть ttyACM0
else
	panel "9999"   # dwc2 так и не пробился за 120 с
fi

# Shell на USB-serial (если gadget жив): туда же шёл скан
[ -n "$gadget" ] &&
	setsid sh -c 'exec sh </dev/ttyGS0 >/dev/ttyGS0 2>&1' 2>/dev/null &

echo
echo "### scan-bad-pebs initrd: система в RAM, NAND только читается"
[ -n "$gadget" ] &&
	echo "### вывод: UART и USB-C (/dev/ttyACM0 на хосте)" ||
	echo "### USB gadget не поднялся - вывод только в UART"

if [ -n "$gadget" ]; then
	echo "# === 8< === COPY bad-pebs 8< ===" > /dev/console
	echo "# === 8< === COPY bad-pebs 8< ===" > /dev/ttyGS0
	sh /scan 2>&1 | tee /dev/console /dev/ttyGS0 > /dev/null
	echo "# === 8< === END bad-pebs 8< ===" > /dev/console
	echo "# === 8< === END bad-pebs 8< ===" > /dev/ttyGS0
else
	echo "# === 8< === COPY bad-pebs 8< ==="
	sh /scan
	echo "# === 8< === END bad-pebs 8< ==="
fi

echo
echo "# MTD/ECC-строки ядра за скан, для сведений:"
dmesg | grep -iE "mtd|ecc|bad" | tail -n 30 | sed 's/^/# /' > /dev/console
[ -n "$gadget" ] &&
	dmesg | grep -iE "mtd|ecc|bad" | tail -n 30 | sed 's/^/# /' > /dev/ttyGS0

echo
echo "### готово. Shell: UART$( [ -n "$gadget" ] && echo ' и ttyGS0 (USB-C)'). Выключить: poweroff -f"
# Мы PID 1: shell вместо exec, чтобы после exit платы не паниковала зря.
sh
poweroff -f
